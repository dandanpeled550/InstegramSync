# Copy to .env.local / .env.dev / .env.prod (all gitignored). APP_ENV picks the file.
# Values here are placeholders only — this repo is public.

APP_ENV=local

# Supabase (per environment)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Models
JEV_API_KEY=replace-me
GEMINI_API_KEY=replace-me

# Local web UI / API (docs/contracts/api.md section 1, ADR 0004)
# Only 127.0.0.1 is supported; the server refuses to start on any other value.
API_HOST=127.0.0.1
API_PORT=8000
# Optional: Vite dev server origin (loopback http only), e.g. http://localhost:5173
API_DEV_ORIGIN=
# Login password, at least 12 characters (server refuses to start otherwise). Choose your own.
APP_PASSWORD=replace-me
# At least 32 bytes. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating it revokes every session.
SESSION_SECRET=replace-me
# Only the exact value "false" disables auth (loopback bind only); anything else means on.
AUTH_ENABLED=true

# Edge Function secrets are NOT set here — use `supabase secrets set` (human gate):
#   META_APP_SECRET, META_VERIFY_TOKEN, ALLOWED_SENDER_IDS
